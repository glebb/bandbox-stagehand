# Copy to signing.env (kept out of git) to sign and install the iPhone app with ./ios-build.sh.
# Variables set in the environment win over this file.

# Your Apple team ID: Xcode › Settings › Accounts › your team, or the OU of your
# "Apple Development" certificate in Keychain Access. A free personal team works.
BANDBOX_TEAM=ABCDE12345

# Any ID of your own; a free team can only sign IDs no one else has registered.
BANDBOX_BUNDLE_ID=com.example.bandbox-stagehand
